# Generate token/password with: openssl rand -hex 32
ORCHESTRATOR_TOKEN=
POSTGRES_PASSWORD=
# Local development database; Compose supplies its own internal URL.
DATABASE_URL=postgres://orquestrator:replace-me@127.0.0.1:5432/orquestrator
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
PORT=3000

# Optional, separate from owner token. Minimum 32 characters.
WEBHOOK_SECRET=
